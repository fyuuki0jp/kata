      "status": "PROVED",
      "encoding": "(set-logic QF_LIA)\n\n(declare-const result_ok Bool)\n(declare-const result_value Int)\n(declare-const args_balance Int)\n(declare-const args_amount Int)\n\n(assert (ite result_ok (>= result_value 0) true))\n(assert (ite result_ok (= result_value (- args_balance args_amount)) true))\n(assert (ite (< args_balance args_amount) (not result_ok) true))\n\n(check-sat)",
      "counterexample": {
        "result_ok": "false",
        "args_amount": "0",
        "args_balance": "(- 2)",
        "result_value": "(- 1)"
      },
      "reason": "Laws are consistent"
    },
    {
      "obligationId": "LAW-CreditAlwaysSucceeds:smt:consistency",
      "status": "PROVED",
      "encoding": "(set-logic QF_LIA)\n\n(declare-const args_amount Int)\n(declare-const result_ok Bool)\n(declare-const result_value Int)\n(declare-const args_balance Int)\n\n(assert (ite (> args_amount 0) (= result_ok true) true))\n(assert (ite result_ok (= result_value (+ args_balance args_amount)) true))\n\n(check-sat)",
