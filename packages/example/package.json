{
  "name": "example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts & vite --config vite.config.ts & wait",
    "dev:api": "tsx watch src/server.ts",
    "dev:client": "vite --config vite.config.ts",
    "spec:compile": "pnpm build:seizu && node --import tsx/esm ../seizu-cli/src/cli.ts compile --config seizu.config.ts",
    "spec:verify": "pnpm run spec:compile && node --import tsx/esm ../seizu-cli/src/cli.ts verify --specs --config seizu.config.ts",
    "spec:doc": "node --import tsx/esm ../seizu-cli/src/cli.ts doc --specs --config seizu.config.ts --stdout",
    "build:seizu": "cd ../seizu && pnpm build"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/node-server": "^1.0.0",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "fast-check": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "seizu": "workspace:*",
    "seizu-cli": "workspace:*",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
