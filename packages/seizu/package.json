{
  "name": "seizu",
  "version": "2.0.0",
  "description": "Contract-based state transition library for TypeScript",
  "keywords": [
    "contract",
    "state-transition",
    "ddd",
    "typescript",
    "pbt"
  ],
  "author": "seizu Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyuuki0jp/seizu.git",
    "directory": "packages/seizu"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./verify": {
      "import": {
        "types": "./dist/verify/index.d.ts",
        "default": "./dist/verify/index.js"
      },
      "require": {
        "types": "./dist/verify/index.d.cts",
        "default": "./dist/verify/index.cjs"
      }
    },
    "./spec": {
      "import": {
        "types": "./dist/spec.d.ts",
        "default": "./dist/spec.js"
      },
      "require": {
        "types": "./dist/spec.d.cts",
        "default": "./dist/spec.cjs"
      }
    },
    "./smt": {
      "import": {
        "types": "./dist/smt/index.d.ts",
        "default": "./dist/smt/index.js"
      },
      "require": {
        "types": "./dist/smt/index.d.cts",
        "default": "./dist/smt/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "spec:compile": "pnpm build && node --import tsx/esm ../seizu-cli/src/cli.ts compile --config seizu.config.ts",
    "spec:verify": "pnpm build && node --import tsx/esm ../seizu-cli/src/cli.ts verify --specs --config seizu.config.ts",
    "spec:doc": "pnpm build && node --import tsx/esm ../seizu-cli/src/cli.ts doc --specs --config seizu.config.ts --stdout"
  },
  "peerDependencies": {
    "fast-check": "^3.0.0",
    "z3-solver": "^4.12.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    },
    "z3-solver": {
      "optional": true
    }
  },
  "devDependencies": {
    "fast-check": "^3.23.2"
  }
}
